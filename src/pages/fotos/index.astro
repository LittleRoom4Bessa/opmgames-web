---
import Base from "../../layouts/Base.astro";
import { getAlbums, formatDate, containsCjk } from "../../lib/content";

const albums = await getAlbums();
const hasCjk = albums.some((album) => containsCjk(album.data.title));
---

<Base title="Fotos" description="Photo albums — field notes in pictures." hasCjk={hasCjk}>
  <section class="page">
    <p class="kick" style="margin-bottom:1.625rem"><b>/ FOTOS</b> — ALBUMS</p>
    <h1 class="display" style="font-size:clamp(2.625rem, 1.4rem + 3.4vw, 5rem)">Field notes,<br /><em>in pictures.</em></h1>
    <div class="index" style="margin-top:8vh">
      {albums.length === 0 && <p class="empty">Nothing filed yet…</p>}
      {albums.length > 0 && (
        <ul role="list">
          {albums.map((album, i) => (
            <li>
              <a class="row" href={`/fotos/${album.id}/`}>
                <span class="no">{String(i + 1).padStart(2, "0")}</span>
                <span class="t" lang={containsCjk(album.data.title) ? "zh" : undefined}>{album.data.title}</span>
                <span class="cat">{album.data.photos.length} fotos</span>
                <span class="date">{formatDate(album.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
