---
import Base from "../layouts/Base.astro";
import { getPosts, getAlbums, formatDate } from "../lib/content";

const posts = await getPosts();
const albums = await getAlbums();

// merge posts + albums by date, newest first
const latest = [
  ...posts.map((p) => ({
    title: p.data.title,
    href: `/blog/${p.id}/`,
    cat: p.data.category,
    date: p.data.pubDate,
  })),
  ...albums.map((a) => ({
    title: a.data.title,
    href: `/fotos/${a.id}/`,
    cat: "Fotos",
    date: a.data.date,
  })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 5);
---

<Base title="Home" description="OPM is an independent game developer. Devlogs, essays, and photographs from a one-person studio.">
  <section class="page">
    <span class="crosshair" style="top:6vh;right:2vw" aria-hidden="true">+++</span>
    <p style="font-size:18px;line-height:1.75;color:#403c34;max-width:54ch;margin-bottom:5vh">
      Devlogs, essays, and photographs from a one-person studio. Nothing here is
      optimized for engagement; it is a workshop with the door left open.
    </p>
    <h1 class="display" style="font-size:clamp(48px,7vw,104px)">
      Making small<br /><span class="px">GAMES</span>, slowly,<br /><em>and writing about it.</em>
    </h1>

    <p class="kick" style="margin:11vh 0 16px"><b>/ LATEST</b> — FROM ALL DESKS</p>
    <div class="index">
      {latest.map((item, i) => (
        <a class="row" href={item.href}>
          <span class="no">{String(i + 1).padStart(2, "0")}</span>
          <span class="t">{item.title}</span>
          <span class="cat">{item.cat}</span>
          <span class="date">{formatDate(item.date)}</span>
        </a>
      ))}
    </div>
    <span class="crosshair" style="bottom:8vh;left:38vw" aria-hidden="true">+++</span>
  </section>
</Base>
