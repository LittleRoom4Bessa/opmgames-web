---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPosts, getAlbums, formatDate } from '../lib/content';

const posts = (await getPosts()).slice(0, 4);
const albums = (await getAlbums()).slice(0, 3);
---

<Base title="OPM Games" description="Personal site of an indie game developer — devlogs, essays, and photos.">
  <section class="hero">
    <h1>Hi, I'm OPM — I make games.</h1>
    <p>
      This is my corner of the internet: devlogs from whatever I'm building,
      essays on design and the indie life, and the occasional photo album.
    </p>
  </section>

  {posts.length > 0 && (
    <section>
      <h2>Latest writing</h2>
      <ul class="card-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}><strong>{post.data.title}</strong></a>
            <p class="meta" style="margin: var(--space-1) 0 0">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {' · '}
              <span class="badge">{post.data.category}</span>
            </p>
          </li>
        ))}
      </ul>
      <p><a href="/blog">All posts →</a></p>
    </section>
  )}

  {albums.length > 0 && (
    <section>
      <h2>Latest albums</h2>
      <ul class="home-albums">
        {albums.map((album) => (
          <li>
            <a href={`/gallery/${album.id}/`}>
              <Image
                src={album.data.cover}
                alt={album.data.title}
                widths={[320, 640]}
                sizes="(max-width: 640px) 100vw, 320px"
                loading="lazy"
              />
              <span>{album.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/gallery">All albums →</a></p>
    </section>
  )}
</Base>

<style>
  .hero {
    padding: var(--space-8) 0 var(--space-6);
  }
  .hero h1 {
    margin-top: 0;
  }
  .home-albums {
    list-style: none;
    padding: 0;
    margin: var(--space-6) 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .home-albums a {
    display: block;
    color: var(--color-text);
  }
  .home-albums a:hover {
    text-decoration: none;
  }
  .home-albums img {
    border-radius: 8px;
    border: 1px solid var(--color-border);
    aspect-ratio: 3 / 2;
    object-fit: cover;
    width: 100%;
    margin-bottom: var(--space-2);
  }
</style>
