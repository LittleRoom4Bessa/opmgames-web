---
import Base from "../../layouts/Base.astro";
import BlogIndex from "../../components/BlogIndex.astro";
import { getPosts } from "../../lib/content";

const all = await getPosts();
const posts = all.filter((p) => p.data.category === "devlog");
---

<Base title="Devlogs" description="Devlogs — build notes from the workbench.">
  <section class="page">
    <BlogIndex posts={posts} active="devlog" allIds={all.map((p) => p.id)} />
  </section>
</Base>
