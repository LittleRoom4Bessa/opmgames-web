---
import Base from "../../layouts/Base.astro";
import BlogIndex from "../../components/BlogIndex.astro";
import { getPosts, getTranslationLangs, containsCjk } from "../../lib/content";

const posts = (await getPosts()).filter((p) => !p.data.translationOf);
const allIds = posts.map((p) => p.id);
const translations = await getTranslationLangs();
const hasCjk = posts.some(
  (p) => p.data.lang === "zh" || containsCjk(p.data.title) || containsCjk(p.data.description)
);
---

<Base title="Blog" description="The Daily Build — devlogs and essays from the workbench." hasCjk={hasCjk}>
  <section class="page">
    <BlogIndex posts={posts} active="all" allIds={allIds} translations={translations} />
  </section>
</Base>
