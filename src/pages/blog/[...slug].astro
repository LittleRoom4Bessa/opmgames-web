---
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      allIds: posts.map((p) => p.id),
      prev: posts[i + 1] ?? null, // older
      next: posts[i - 1] ?? null, // newer
    },
  }));
}

const { post, allIds, prev, next } = Astro.props;
const { Content } = await render(post);
const number = String(allIds.length - allIds.indexOf(post.id)).padStart(3, "0");
---

<Base title={post.data.title} description={post.data.description} lang={post.data.lang}>
  <article class="page">
    <header class="article-head">
      <span class="kick"><b>{post.data.category}</b> — № {number}</span>
      <h1>{post.data.title}</h1>
      <span class="dateline">
        {formatDate(post.data.pubDate)} — Filed from the workbench
      </span>
      {post.data.tags.length > 0 && (
        <div class="tags-row">
          {post.data.tags.map((t) => <a href={`/tags/${t}`}>{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav">
      {prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}
      {next && <a class="next" href={`/blog/${next.id}/`}>{next.data.title} →</a>}
    </nav>
  </article>
</Base>
