---
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();
  // indexes and numbering count originals only; translations hang off them
  const originals = posts.filter((p) => !p.data.translationOf);
  return posts.map((post) => {
    const anchorId = post.data.translationOf ?? post.id;
    const i = originals.findIndex((p) => p.id === anchorId);
    const sibling = posts.find(
      (p) => (p.data.translationOf ?? p.id) === anchorId && p.id !== post.id
    );
    return {
      params: { slug: post.id },
      props: {
        post,
        allIds: originals.map((p) => p.id),
        anchorId,
        sibling: sibling ? { id: sibling.id, lang: sibling.data.lang } : null,
        prev: originals[i + 1] ?? null, // older
        next: originals[i - 1] ?? null, // newer
      },
    };
  });
}

const { post, allIds, anchorId, sibling, prev, next } = Astro.props;
const { Content } = await render(post);
const number = String(allIds.length - allIds.indexOf(anchorId)).padStart(3, "0");
---

<Base title={post.data.title} description={post.data.description} lang={post.data.lang}
  translation={sibling ? { href: `/blog/${sibling.id}/`, lang: sibling.lang } : undefined}>
  <article class="page">
    <header class="article-head">
      <span class="kick"><b>{post.data.category}</b> — № {number}</span>
      <h1>{post.data.title}</h1>
      <span class="dateline">
        {formatDate(post.data.pubDate)} — Filed from the workbench
      </span>
      {sibling && (
        <a class="lang-switch" href={`/blog/${sibling.id}/`} hreflang={sibling.lang}
          onclick={`sessionStorage.setItem('opm-lang-manual','1')`}>
          {sibling.lang === "en" ? "English version" : "中文版"} →
        </a>
      )}
      {post.data.tags.length > 0 && (
        <div class="tags-row">
          {post.data.tags.map((t) => <a href={`/tags/${t}`}>{t}</a>)}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav">
      {prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}
      {next && <a class="next" href={`/blog/${next.id}/`}>{next.data.title} →</a>}
    </nav>
  </article>
</Base>
