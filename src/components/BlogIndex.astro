---
// The Daily Build — masthead + section tabs + newsstand stack
import { formatDate, formatMonthYear } from "../lib/content";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
  active: "all" | "devlog" | "essay";
  allIds: string[]; // every published post id, newest first — stable numbering
  translations: Map<string, string[]>; // original id → translation langs
}

const { posts, active, allIds, translations } = Astro.props;
const latest = allIds.length ? posts[0]?.data.pubDate : undefined;
const issue = String(allIds.length).padStart(3, "0");
const volLine = `Vol.1 · No.${issue} · Published irregularly` + (latest ? ` · ${formatMonthYear(latest)}` : "");

// numbering: oldest post = № 001, stable across filtered pages
const number = (id: string) => String(allIds.length - allIds.indexOf(id)).padStart(3, "0");
// wire-style lang marker: own lang + any translation langs, e.g. "ZH · EN"
const langs = (post: CollectionEntry<"blog">) =>
  [post.data.lang, ...(translations.get(post.id) ?? [])].join(" · ").toUpperCase();
---

<div class="press-head">
  <h1 class="pt"><a href="/blog">The Daily <span class="px">BUILD</span></a></h1>
  <span class="pi">{volLine}</span>
</div>

<nav class="sections" aria-label="Blog sections">
  <ul role="list">
    <li><a href="/blog" class={active === "all" ? "on" : ""} aria-current={active === "all" ? "page" : undefined}>All</a></li>
    <li><a href="/blog/devlogs" class={active === "devlog" ? "on" : ""} aria-current={active === "devlog" ? "page" : undefined}>Devlogs</a></li>
    <li><a href="/blog/essays" class={active === "essay" ? "on" : ""} aria-current={active === "essay" ? "page" : undefined}>Essays</a></li>
  </ul>
</nav>

{posts.length === 0 && <p class="srow-empty">Nothing filed yet…</p>}
{posts.length > 0 && (
  <ul class="stack" role="list">
    {posts.map((post) => (
      <li>
        <a class="srow" href={`/blog/${post.id}/`}>
          <span class="kicker"><b>{post.data.category}</b> — № {number(post.id)} — {langs(post)}</span>
          <div class="peek"><h3 lang={post.data.lang === "zh" ? "zh" : undefined}>{post.data.title}</h3></div>
          <p class="deck" lang={post.data.lang === "zh" ? "zh" : undefined}>{post.data.description}</p>
          <span class="dateline">{formatDate(post.data.pubDate)}</span>
        </a>
      </li>
    ))}
  </ul>
)}
