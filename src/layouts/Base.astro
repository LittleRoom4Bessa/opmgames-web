---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  translation?: { href: string; lang: string };
  frontmatter?: { title: string; description?: string; lang?: string };
}

const fp = Astro.props.frontmatter;
const title = fp?.title ?? Astro.props.title;
const description = fp?.description ?? Astro.props.description ?? "OPM — a one-person studio. Devlogs, essays, and photographs.";
const pageTitle = title === "Home" ? "OPM Games" : `${title} — OPM Games`;
const lang = fp?.lang ?? Astro.props.lang ?? "en";
const translation = Astro.props.translation;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// current section from path → header label + dock active state
const seg = Astro.url.pathname.split("/")[1] || "home";
const section = ["blog", "fotos", "about", "tags"].includes(seg) ? seg : "home";
const here = "/ " + section.toUpperCase();
const nav = [
  { id: "home", label: "Home", href: "/" },
  { id: "blog", label: "Blog", href: "/blog" },
  { id: "fotos", label: "Fotos", href: "/fotos" },
  { id: "about", label: "About", href: "/about" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="OPM Games" href="/rss.xml" />
    {translation && <link rel="alternate" hreflang={translation.lang} href={new URL(translation.href, Astro.site)} />}
    {translation && (
      <script is:inline define:vars={{ translationHref: translation.href, pageLang: lang, targetLang: translation.lang }}>
        (function () {
          try {
            if (sessionStorage.getItem("opm-lang-manual")) return;
            var langs = navigator.languages || [navigator.language];
            var has = function (l) {
              return langs.some(function (x) {
                return x && x.toLowerCase().indexOf(l) === 0;
              });
            };
            if (!has(pageLang) && has(targetLang)) location.replace(translationHref);
          } catch (e) {}
        })();
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,800&family=Newsreader:ital,wght@0,400;1,400&family=Silkscreen:wght@700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-head">
      <span class="here">{here}</span>
      <a class="logo" href="/">OPM Games</a>
      <span class="slot">Est. 2026</span>
    </header>

    <nav class="dock" aria-label="Site">
      <a class="brand" href="/" style="writing-mode:vertical-rl">O.</a>
      <div class="rule"></div>
      {nav.map((item) => (
        <a href={item.href} class={section === item.id ? "active" : ""} aria-current={section === item.id ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <main class="page-frame" id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <span>© {new Date().getFullYear()} OPM Games</span>
      <span><a href="/rss.xml">RSS</a> · Archivo × Newsreader × Times × Silkscreen</span>
    </footer>
  </body>
</html>
